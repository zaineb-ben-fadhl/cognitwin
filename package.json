{
  "name": "cognitwin",
  "version": "1.0.0",
  "private": true,
  "description": "CogniTwin — a non-clinical, explainable cognitive growth agent with a historised Brain Twin (CISTAC 1.0 AI4Brain).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/sync-camera-assets.mjs",
    "predev": "node scripts/sync-camera-assets.mjs",
    "prebuild": "node scripts/sync-camera-assets.mjs",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch --import tsx server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "node --watch --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@mediapipe/tasks-vision": "^0.10.34",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
