# Optional. Without a key the coach runs fully offline in deterministic template mode.
ANTHROPIC_API_KEY=
# Model used by the LLM narrative layer (see docs/COACH.md for the justification).
COACH_MODEL=claude-opus-5-5
# Effort level for the narrative layer (low keeps chat latency short; the engine already did the analysis).
COACH_EFFORT=low
# Port of the API server (the Vite dev server proxies /api to it).
API_PORT=8787
# Optional on networks using certificates trusted by Windows/macOS. Requires recent Node 22/24.
# Keeps TLS verification enabled; adds the operating system's trusted certificate roots.
COACH_USE_SYSTEM_CA=false
